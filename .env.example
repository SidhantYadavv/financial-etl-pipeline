# NewsAPI key from https://newsapi.org/account
NEWS_API_KEY=your-newsapi-key

# Postgres started by `docker compose up -d`
DATABASE_URL=postgresql+psycopg://etl:etl@localhost:5434/financial_news

# Separate database used by pytest. Its tables are truncated between tests.
TEST_DATABASE_URL=postgresql+psycopg://etl:etl@localhost:5434/financial_news_test

# Max NewsAPI requests a single run may make (free tier: 100/day total)
NEWS_API_REQUEST_BUDGET=80

# Password for the read-only Postgres role that agent tools connect as.
# Created by `alembic upgrade head`; pick any long random string.
AGENT_READONLY_PASSWORD=change-me-to-a-long-random-string
